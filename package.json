{
  "name": "gran-hotel-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Sistema de Gestion Hotelera - Dashboard administrativo en React + TypeScript + Tailwind CSS",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "check:ssr": "vite build --ssr scripts/ssr-check.tsx --outDir dist-ssr --logLevel error && node dist-ssr/ssr-check.js"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "lucide-react": ">=0.400.0",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.0 || ^19.0.0",
    "@types/react-dom": "^18.3.0 || ^19.0.0",
    "@vitejs/plugin-react": "^4.3.0 || ^5.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0 || ^7.0.0"
  }
}
